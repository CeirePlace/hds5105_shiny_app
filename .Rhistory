hormones <- read_csv(file.path(data_dir, "hormones_and_selfreport.csv"))
temp     <- read_csv(file.path(data_dir, "computed_temperature.csv"))
rhr      <- read_csv(file.path(data_dir, "resting_heart_rate.csv"))
hormones <- hormones %>%
select(id, day_in_study, study_interval, phase, lh, pdg)
temp <- temp %>%
group_by(id, day_in_study = sleep_end_day_in_study) %>%
summarise(temperature = mean(nightly_temperature, na.rm = TRUE), .groups = "drop")
rhr <- rhr %>%
group_by(id, day_in_study) %>%
summarise(resting_hr = mean(value, na.rm = TRUE), .groups = "drop")
daily <- hormones %>%
left_join(temp, by = c("id", "day_in_study")) %>%
left_join(rhr,  by = c("id", "day_in_study"))
phase_runs <- daily %>%
filter(!is.na(phase)) %>%
arrange(id, study_interval, day_in_study) %>%
group_by(id, study_interval) %>%
mutate(run_id = cumsum(phase != lag(phase, default = "none"))) %>%
group_by(id, study_interval, run_id, phase) %>%
summarise(start_day = min(day_in_study), end_day = max(day_in_study), .groups = "drop")
period_starts <- phase_runs %>%
filter(phase == "Menstrual") %>%
group_by(id, study_interval) %>%
filter(is.na(lag(end_day)) | start_day - lag(end_day) > 10) %>%
mutate(cycle = row_number(),
next_start = lead(start_day),
cycle_length = next_start - start_day) %>%
ungroup() %>%
select(id, study_interval, cycle, start_day, next_start, cycle_length)
# give every day its cycle number and day of cycle
daily <- daily %>%
left_join(period_starts, by = c("id", "study_interval"), relationship = "many-to-many") %>%
filter(day_in_study >= start_day, is.na(next_start) | day_in_study < next_start) %>%
mutate(cycle_day = day_in_study - start_day + 1)
peaks <- daily %>%
filter(!is.na(lh)) %>%
group_by(id, study_interval, cycle) %>%
filter(n() >= 10) %>%                    # need enough readings
slice_max(lh, n = 1, with_ties = FALSE) %>%
select(id, study_interval, cycle, peak_day = day_in_study, lh_peak = lh)
daily <- daily %>%
left_join(peaks, by = c("id", "study_interval", "cycle")) %>%
mutate(days_from_peak = day_in_study - peak_day,
cycle_id = paste(id, study_interval, cycle))   # a unique label for each cycle
period_starts %>%
filter(!is.na(cycle_length), cycle_length <= 62) %>%
ggplot(aes(cycle_length)) +
geom_histogram(binwidth = 1, fill = "steelblue") +
facet_wrap(~ study_interval) +
labs(x = "Cycle length (days)", y = "Number of cycles")
daily %>%
filter(between(days_from_peak, -15, 15), !is.na(lh)) %>%
ggplot(aes(days_from_peak, lh)) +
geom_line(aes(group = cycle_id), alpha = 0.1) +
stat_summary(fun = median, geom = "line", colour = "red", linewidth = 1) +
scale_y_log10() +
labs(x = "Days from LH peak", y = "LH (log scale)")
daily %>%
filter(between(days_from_peak, -15, 15), !is.na(temperature)) %>%
group_by(id) %>%
mutate(temp_centred = temperature - mean(temperature)) %>%
ggplot(aes(days_from_peak, temp_centred)) +
geom_line(aes(group = cycle_id), alpha = 0.1) +
stat_summary(fun = mean, geom = "line", colour = "red", linewidth = 1) +
geom_vline(xintercept = 0, linetype = "dashed") +
labs(x = "Days from LH peak", y = "Temperature vs person's average")
daily %>%
filter(between(days_from_peak, -15, 15), !is.na(resting_hr)) %>%
group_by(id) %>%
mutate(rhr_centred = resting_hr - mean(resting_hr)) %>%
ggplot(aes(days_from_peak, rhr_centred)) +
geom_line(aes(group = cycle_id), alpha = 0.1) +
stat_summary(fun = mean, geom = "line", colour = "red", linewidth = 1) +
geom_vline(xintercept = 0, linetype = "dashed") +
labs(x = "Days from LH peak", y = "Resting HR vs person's average")
daily %>%
filter(!is.na(temperature)) %>%
ggplot(aes(temperature, fct_reorder(as.factor(id), temperature))) +
geom_boxplot(fill = "grey90", outlier.size = 0.5) +
labs(x = "Wrist temperature", y = "Participant")
example_id <- daily %>% count(id, sort = TRUE) %>% slice(1) %>% pull(id)
example_interval <- min(daily$study_interval)
daily %>%
filter(id == example_id, study_interval == example_interval) %>%
select(day_in_study, lh, temperature) %>%
pivot_longer(-day_in_study) %>%
filter(!is.na(value)) %>%
ggplot(aes(day_in_study, value)) +
geom_line() +
geom_vline(data = peaks %>% filter(id == example_id, study_interval == example_interval),
aes(xintercept = peak_day), linetype = "dashed", colour = "red") +
facet_wrap(~ name, ncol = 1, scales = "free_y") +
labs(x = "Day in study", y = NULL, title = paste("Participant", example_id))
daily %>%
filter(between(days_from_peak, -15, 15), !is.na(temperature)) %>%
group_by(id) %>%
mutate(temp_centred = temperature - mean(temperature)) %>%
filter(temp_centred <2) %>%
ggplot(aes(days_from_peak, temp_centred)) +
geom_line(aes(group = cycle_id), alpha = 0.1) +
stat_summary(fun = mean, geom = "line", colour = "red", linewidth = 1) +
geom_vline(xintercept = 0, linetype = "dashed") +
labs(x = "Days from LH peak", y = "Temperature vs person's average")
daily %>%
filter(between(days_from_peak, -15, 15), !is.na(temperature)) %>%
group_by(id) %>%
mutate(temp_centred = temperature - mean(temperature)) %>%
filter(temp_centred <2, temp_centred >-2) %>%
ggplot(aes(days_from_peak, temp_centred)) +
geom_line(aes(group = cycle_id), alpha = 0.1) +
stat_summary(fun = mean, geom = "line", colour = "red", linewidth = 1) +
geom_vline(xintercept = 0, linetype = "dashed") +
labs(x = "Days from LH peak", y = "Temperature vs person's average")
temp_shift <- daily %>%
filter(!is.na(temperature), !is.na(days_from_peak)) %>%
group_by(id, study_interval) %>%
mutate(temp_centred = temperature - mean(temperature)) %>%
group_by(cycle_id) %>%
summarise(before = mean(temp_centred[between(days_from_peak, -10, -2)]),
after  = mean(temp_centred[between(days_from_peak, 4, 10)]),
shift  = after - before)
ggplot(temp_shift, aes(shift)) +
geom_histogram(binwidth = 0.05, fill = "steelblue") +
geom_vline(xintercept = 0, linetype = "dashed") +
labs(x = "Temperature after LH peak minus before (°C)", y = "Number of cycles")
mean(temp_shift$shift > 0, na.rm = TRUE)
